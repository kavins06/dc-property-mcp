# PostgreSQL administrative access is used only for controlled migrations,
# loading, verification, backup, and restore. Use disable only for a local Unix
# socket or a separately authenticated SSH tunnel.
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=dc_property
DATABASE_ADMIN_USER=dc_property_admin
DATABASE_ADMIN_PASSWORD=
# Neon uses a managed login role, then assumes the non-login ownership role.
DATABASE_ADMIN_LOGIN_USER=
DATABASE_ADMIN_LOGIN_PASSWORD=
DATABASE_RUNTIME_USER=mcp_runtime
DATABASE_SSL_MODE=verify-full
PRODUCTION_DATABASE_OID=
PRODUCTION_SYSTEM_IDENTIFIER=

# DMV loaders remain locked to an exact isolated rehearsal target until the
# owner explicitly approves production loading and publication.
DMV_REHEARSAL_ONLY=false
DMV_REHEARSAL_TARGET_MARKER=
DMV_REHEARSAL_DATABASE_NAME=
DMV_REHEARSAL_DATABASE_OID=
DMV_REHEARSAL_SYSTEM_IDENTIFIER=

# Leave unset until the owner explicitly approves DMV production publication.
DMV_OWNER_PUBLICATION_APPROVAL=
DMV_OWNER_APPROVED_BUNDLE_SHA256=

# Least-privileged password used only by Cloudflare Hyperdrive.
DC_PROPERTY_RUNTIME_PASSWORD=

# Cloudflare deployment metadata and scoped API credential.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Hetzner S3-compatible Object Storage.
HETZNER_S3_ACCESS_KEY_ID=
HETZNER_S3_SECRET_ACCESS_KEY=
HETZNER_S3_REGION=fsn1
HETZNER_S3_ENDPOINT=https://fsn1.your-objectstorage.com
HETZNER_S3_BUCKET=

# Dedicated 32-byte archive key, encoded as canonical base64. Keep it separate
# from database and S3 credentials; losing it makes SSE-C objects unreadable.
ARCHIVE_SSE_C_KEY_BASE64=

# WorkOS public metadata. No WorkOS API secret is required by the Worker.
WORKOS_AUTHKIT_DOMAIN=
WORKOS_RESOURCE_URI=https://mcp.quoindata.com/mcp
