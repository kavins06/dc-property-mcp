[global]
repo1-type=s3
repo1-path=/backups/dc-property/pgbackrest
repo1-s3-bucket=quoindata
repo1-s3-endpoint=https://fsn1.your-objectstorage.com
repo1-s3-region=fsn1
repo1-s3-key=SET_FROM_HETZNER_S3_ACCESS_KEY_ID
repo1-s3-key-secret=SET_FROM_HETZNER_S3_SECRET_ACCESS_KEY
repo1-s3-uri-style=path
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=GENERATE_A_UNIQUE_RANDOM_SECRET
repo1-retention-full=4
repo1-retention-diff=14
repo1-bundle=y
repo1-block=y
compress-type=zst
compress-level=3
archive-async=y
archive-timeout=300
spool-path=/var/spool/pgbackrest
process-max=1
start-fast=y
log-level-console=info
log-level-file=detail

[dc-property]
pg1-path=/mnt/HC_Volume_106250480/dc-property/pgdata
pg1-port=5434
pg1-socket-path=/run/postgresql-dc-property
