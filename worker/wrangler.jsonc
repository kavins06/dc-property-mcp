{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dc-property-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "mcp.quoindata.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "WORKOS_AUTHKIT_DOMAIN": "ripe-theater-06.authkit.app",
    "WORKOS_RESOURCE_URI": "https://mcp.quoindata.com/mcp",
    "ALLOWED_ORIGINS": "",
    "BILLING_ENFORCEMENT": "on",
    "ENTITLEMENT_HELP_URL": "https://quoindata.com/docs/troubleshooting#subscription-access",
    "POSTHOG_HOST": "https://us.i.posthog.com",
    "ENVIRONMENT": "production"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5fd47b059f824188998ad4ce9dc4503c",
      "localConnectionString": "postgresql://mcp_runtime:local@127.0.0.1:5432/dc_property"
    }
  ],
  "d1_databases": [
    {
      "binding": "BILLING_DB",
      "database_name": "quoin-billing-production",
      "database_id": "8dd29294-62b2-4edc-b483-c7064260f8d0"
    }
  ],
  "ratelimits": [
    {
      "name": "GENERAL_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "SEARCH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  "env": {
    "staging": {
      "name": "dc-property-mcp-staging",
      "workers_dev": false,
      "preview_urls": true,
      "routes": [
        {
          "pattern": "dc-property-mcp.quoindata.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "WORKOS_AUTHKIT_DOMAIN": "poignant-name-31-staging.authkit.app",
        "WORKOS_RESOURCE_URI": "https://dc-property-mcp.quoindata.com/mcp",
        "ALLOWED_ORIGINS": "",
        "BILLING_ENFORCEMENT": "on",
        "ENTITLEMENT_HELP_URL": "https://billing-staging.quoindata.com/docs/troubleshooting#subscription-access",
        "POSTHOG_HOST": "https://us.i.posthog.com",
        "ENVIRONMENT": "preview"
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "5fd47b059f824188998ad4ce9dc4503c",
          "localConnectionString": "postgresql://mcp_runtime:local@127.0.0.1:5432/dc_property"
        }
      ],
      "d1_databases": [
        {
          "binding": "BILLING_DB",
          "database_name": "quoin-billing-staging",
          "database_id": "762156fb-fa56-4f3c-9780-1047c03119bc"
        }
      ],
      "ratelimits": [
        {
          "name": "GENERAL_RATE_LIMITER",
          "namespace_id": "2001",
          "simple": {
            "limit": 120,
            "period": 60
          }
        },
        {
          "name": "SEARCH_RATE_LIMITER",
          "namespace_id": "2002",
          "simple": {
            "limit": 20,
            "period": 60
          }
        }
      ]
    }
  }
}
